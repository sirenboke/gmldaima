global.cinematicInfo[0][0] = "*Cinematic start*";
global.cinematicInfo[0][1] = "Among ruins and fading screams, your footsteps echo over the ground covered in ash and dried blood.\nYou have defeated the Underworld Tower Guardians, claimed silence in a realm forged of darkness and despair...\nBut silence never lasts...";
global.cinematicInfo[0][2] = "*You start hearing whispers in your ears...*\nQuickly the whispers transform into a deep voice. It comes from no throat but from the air itself:\ndistorted,\nomnipresent,\nalmost telepathic...";
global.cinematicInfo[0][3] = "Unknown Voice: You have no idea what you have just done, what you thought was liberation was a blow of pure ignorance.\nMountains devouring themselves, skies losing their color, memories dissolving like blood in the rain.\nThe world as you know it will meet its end because of your actions...\nFor destroying what kept the balance for so long...\nNow you are going to face the consequences!";
global.cinematicInfo[0][4] = "*A big trembling begins*\nThe ground splits beneath your feet, huge fissures open as seconds pass... Then all you can hear is a roar that tears the abyss apart.\nRight at the center of the Underworld Fortress a giant red portal opens. From the Core of the Underworld, something emerges...\nsomething vast.";
global.cinematicInfo[0][5] = "A colossal beast starts crawling from the portal...\nOlder than fear itself...\nHungrier than death...\n...And it is you that has waken it up...";
global.cinematicInfo[0][6] = "*Cinematic end*";
global.cinematicInfo[1][0] = "*Cinematic start*";
global.cinematicInfo[1][1] = "*ROOOOOAAAAARRRRR!!!!!*";
global.cinematicInfo[1][2] = "Unknown Voice: Your efforts are meaningless now. This creatures' only purpose is to protect the Underworld, and a pathetic bunch of humans will never stand a chance against its unlimited power...";
global.cinematicInfo[1][3] = "*Finis spreads its wings, vast as tempests*\n*A single beat sends a wave of dust that forces you to shield your face*\nThe air trembles, the ground quakes, and the colossal beast seems to have flown away...";
global.cinematicInfo[1][4] = "...Between dark flames, dust and smoke, you can see its silhouette above the red portal...\nAnd it seems to have grown...";
global.cinematicInfo[1][5] = "*You feel a strong pressure in your chest*\nThe dragon was not escaping...\nIt became even stronger than it ever was!";
global.cinematicInfo[1][6] = "*RRROOOOOOOOOOAAAAAAAAAAARRRRRRR!!!!!*";
global.cinematicInfo[1][7] = "*Cinematic end*";
global.cinematicInfo[2][0] = "*Cinematic start*";
