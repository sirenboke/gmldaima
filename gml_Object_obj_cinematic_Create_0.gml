global.cinematicInfo[2][2] = "Text 1...";
global.cinematicInfo[2][3] = "Veeeeeeeeeeeeeeeryyyyyyyyyyyyyy laaaaaaaaaaaaaaaaaaaargeeeeeeeeeeeeeeeeeeeeeeee teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeexttttttttttttttttttttt woooooooooooooooooooooooooooooooooooooooooooooooohooooo";
global.cinematicInfo[2][4] = "... short text";
