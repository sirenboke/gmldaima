self.scr_initSkillDescriptions = function()
{
    global.skillDescriptions = [];
    global.skillDescriptions[gml_Script_scr_warrior_skill1] = "Deal {DMG}(STR) physical damage to nearby enemies. (T2 effect: Permanently reduce enemies' armor by {ARMOR}).";
    global.skillDescriptions[gml_Script_scr_warrior_skill2] = "Gain {SHIELD}(CON) shield, {ARMOR}(ARMOR) armor and {REGEN}(INT) HP regeneration. (T2 effect: On cast, increase ally constitution by {HP}(CON) for the rest of the combat) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill3] = "Raise your shield, preventing you from attacking but dealing {DMG}(ARMOR) special damage (DoT) to your attackers (T2 effect: Add (INT) scaling to the damage dealt, and constantly reduce your attacker's dexterity by {DEX} (temporarily) while active) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill1_spec1] = "Start spinning with both of your axes towards your enemies, dealing {DMG} physical damage (DoT) and reducing enemies’ armor by {ARMOR} ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill1_spec2] = "Increase both yours and your allies dexterity and luck (cap included) by {DEX}%[+](DEX) and {LUCK}%[+](LUCK), and gain {LS}%[+](LS) lifesteal and {MS} movement speed. Killing enemies extends the duration (for you) and grants you decaying movement speed. On cast, reduce enemies’ armor and dexterity by 10%[x] ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill1_spec3] = "Your next attack gains extra range and deals {DMG}(STR) true damage. If the target was bleeding, deal twice the damage instead ({DMG2}). If the target whas affected by hemorrhage, Guillotine critically strikes and consumes the hemorrhage effect, instantly dealing its remaining damage as true damage. If it's the first time you damage the target, stun it.";
    global.skillDescriptions[gml_Script_scr_warrior_skill2_spec1] = "Raise your shield, reducing your dexterity but giving +20%[+] global damage resistance and {SHIELD}(CON) shield to you and your ally. When the shield is destroyed, push away nearby enemies ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill2_spec2] = "Summon {AMT} Holy Swords that strike the battlefield from the sky, each dealing {DMG}(INT) true damage on impact and burning all enemies hit, dealing {DMG2}(INT) status damage (DoT) for the duration and applying {STK} burn stacks ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill2_spec3] = "Create a magic circle around you and your ally, cleansing all negative effects and increasing HP regeneration for both you and your ally by {REG}(HPS). Allies inside the circle will heal {HEAL}(INT) HP and deal {DMG}(INT) true damage when dealing damage ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill3_spec1] = "Store up to {DMG}(INT) mitigated damage into an orb that explodes when Focus ends or maximum capacity is reached, dealing up to {DMG2}(INT) (increased by stored amount) special damage to the nearest enemy ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_warrior_skill3_spec2] = "Perform {DUR} sword swings with huge energy, creating shockwaves that travel towards your enemies dealing {DMG}(STR) special damage and applying bleed. If an enemy is killed by the impact, swing an extra time.";
    global.skillDescriptions[gml_Script_scr_warrior_skill3_spec3] = "You start the combat with this ability active. Charge towards your enemies at increasing speeds, dealing {DMG}(INT+SPD) physical damage, increased by your current movement speed. If a collision with an enemy is lethal, keep charging without losing speed, otherwise stun the target and lose all momentum. If the distance traveled was too short push the enemy away instead, dealing {DMG2}(INT) physical damage ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_ranger_skill1] = "Aim for your enemies' head, increasing your strength by {STR}(STR) and luck by {LUCK}%[+], and making your shots undodgeable. (T2 effect: Also increase your dexterity by {DEX} and range by {RNG}) ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill2] = "Your next arrow will penetrate through a few enemies, dealing {DMG}(STR) additional special damage and applying bleed. (T2 effect: Increase the piercing ammo, their ability to pierce through more enemies and their bleed healing reduction strength) ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill3] = "Imbue your next arrow with fire, making it apply a burn stack to your target, dealing additional {DMG}(STR+INT) status damage (DoT). (T2 effect: Increase number of burn stacks applied per arrow by {STK}) ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill1_spec1] = "In addition to all Precision effects (+{STR}(STR) strength and +{LUCK}%[+] luck), your critical strikes do {DMG}%[x] higher damage. While no enemies are close to you, target the lowest HP enemy in range ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill1_spec2] = "Shoot {AMT} arrows at a time while active ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill1_spec3] = "Shoot a barrage of arrows to the sky which will fall into the battlefield, dealing {DMG}(STR) physical damage (DoT) to all enemies within an area ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_ranger_skill2_spec1] = "In addition to all Piercing Arrows effects, bolts also apply basic attack effects. Lose 50% attack range ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill2_spec2] = "Place traps across the battlefield. If an enemy steps in one, reduce their global resistance by {RES}%[+] and armor by {ARMOR}%[x], stun them, deal {DMG}(INT) special damage to them, and apply bleeding at 90% healing reduction. You will also get a {BUFF}%[x] buff to all your stats for {DUR} seconds when an enemy is trapped.";
    global.skillDescriptions[gml_Script_scr_ranger_skill2_spec3] = "Take a moment to aim for your target’s weak spot and shoot a big bolt, dealing {DMG}(STR) true damage that can critically strike (25% of your luck as crit chance, 25% of your crit damage) and interrupt the target, as well as reducing all their resistances by {RES}%[+] for a short duration and their armor by {ARMOR} permanently. If the shot is lethal, deal {DMG2} physical damage to the next enemy.";
    global.skillDescriptions[gml_Script_scr_ranger_skill3_spec1] = "Your arrows will explode when impacting your target, dealing {DMG}(INT+STR) AoE status damage and applying burn stacks to all enemies hit (effectiveness decreases with distance from original target). While active, you prioritize targeting groups of enemies ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill3_spec2] = "Shoot a lightning arrow which will get stuck on your target and send lightning arcs that will bounce between nearby enemies, dealing {DMG}(INT+STR) special damage. All enemies affected will get zapped ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_ranger_skill3_spec3] = "Shoot a poisonous arrow to the enemy with the highest HP in range. On impact, the arrow has a chance to spread the poison and infect nearby enemies with 1 poison stack, dealing {DMG}(INT+STR) status damage (DoT) per stack ({DUR} ammo).";
    global.skillDescriptions[gml_Script_scr_wizard_skill1] = "Periodically summon lightning bolts that deal {DMG}(INT) special damage to random enemies across the battlefield and have a small chance to zap them. (T2 effect: Enemies defeated by this ability emanate smaller bolts that expand towards all directions replicating the damage (DoT) and zapping enemies) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill2] = "Heal yourself and your ally for {HEAL}(INT) HP and increase your strength by {STR}(INT) and armor by {ARMOR} for the duration (T2 effect: Deal {DMG}(INT) status damage (DoT) to your attackers) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill3] = "Summon a powerful blizzard that applies freezing and deals {DMG}(INT) status damage (DoT) in a big area. (T2 effect: Generate {SHIELD}(INT) shield per second while it's active) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill1_spec1] = "Cast powerful plasma beams from the sky that continously deal {DMG}(INT) damage (DoT) to all enemies they pass through, with a chance of also zapping them. When zapping or defeating an enemy, plasma bolts bounce to nearby enemies repeating the damage ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill1_spec2] = "Invoke (5 to {AMT}) unstable runes around you that will automatically target nearby enemies and deal {DMG}(INT) special damage ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill1_spec3] = "After a long canalization, cast a deadly ray that deals {DMG}(INT) (continously increasing by 20%[+] over time (100%[+]/s)) special damage (DoT) to the closest enemy. The damage gets reset when defeating its target ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill2_spec1] = "Grant yourself and your ally {ARMOR} armor, {STR}(INT) strength and {REGEN}(INT) HP regeneration. Your attackers have a chance to burn and your basic attacks have a chance to ignite enemies ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill2_spec2] = "Surround yourself and your ally with a magic field that deflects all enemy special damage (up to {DMG}(INT) damage) and increases your intelligence and fury gain by {INT}(INT) and {RES}(RES). It will interrupt all enemies upon breaking ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill2_spec3] = "Enchant your allies weapons with a powerful spell, granting {RNG} extra range, {INT}(INT) intelligence and {LUCK}(LUCK)%[+] luck, and making basic attacks deal 50% of their damage ({STR}) as extra special damage (after applying all physical damage on-hit effects) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill3_spec1] = "Summon powerful ice orbs throughout the battlefield that explode dealing {DMG}(INT) status damage and applying {STK} freeze stacks to enemies hit. Gain 1% of your constitution as a shield when applying 10 freeze stacks to an enemy.";
    global.skillDescriptions[gml_Script_scr_wizard_skill3_spec2] = "Cast a rain of meteors that impact the ground, dealing {DMG}(INT) special damage to enemies hit and leaving behind a trail of fire that burns enemies that pass through (status damage, applies burn stacks) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_wizard_skill3_spec3] = "Summon a huge tornado, boosting allies dexterity by {DEX}%[x], agility by {AGI}%[x] and movement speed, and dealing {DMG}(INT) status damage, knocking up enemies that get in its path ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_rogue_skill1] = "Deal {DMG}(STR) special damage to your target, if it dies recover half of the fury cost. (T2 effect: Refill your fury and gain {MS} decaying movement speed when killing an enemy with Deep Cut).";
    global.skillDescriptions[gml_Script_scr_rogue_skill2] = "Increase your dexterity by {DEX} for a few attacks. (T2 effect: While active, increase your luck by {LUCK}%[+] and your attacks pierce through multiple enemies dealing {DMG}(STR) additional physical damage) ({DUR} attacks).";
    global.skillDescriptions[gml_Script_scr_rogue_skill3] = "Hide inside a cloud of smoke, gaining {REG}(CON) HP regeneration and {AGI}%[+] agility for the duration. (T2 effect: Cleanse all your negative status effects and poison nearby enemies for {DMG}(INT) status damage (DoT) while it's active) ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_farmer_skill1] = "Unleash your inner power, increasing all your stats by {ARMOR}%. (T2 effect: Deal {DMG}(STR) physical damage around you when casting Inner Strength ({DUR}s).";
    global.skillDescriptions[gml_Script_scr_farmer_skill2] = "Instantly eat your favorite food, healing {HEAL}(CON+INT) HP. (T2 effect: Exceeding healing from Gluttony deals its value as special damage to the nearest target).";
    global.skillDescriptions[gml_Script_scr_farmer_skill3] = "Hit your enemies with poisonous herbs, dealing {DMG}(INT) special damage to them and reducing their dexterity by {DEX}%[+] for the rest of the combat. (T2 effect: Also reduce enemies' strength by {STR}).";
};
